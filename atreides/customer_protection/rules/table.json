  "items": [
    {
      "id": "15c3-3a.item.01",
      "kind": "EXHIBIT_A_CREDIT",
      "citation": "17 CFR 240.15c3-3a, Item 1",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "1. Free credit balances and other credit balances in customers' security accounts."
    },
    {
      "id": "15c3-3a.item.02",
      "kind": "EXHIBIT_A_CREDIT",
      "citation": "17 CFR 240.15c3-3a, Item 2",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "2. Monies borrowed collateralized by securities carried for the accounts of customers"
    },
    {
      "id": "15c3-3a.item.03",
      "kind": "EXHIBIT_A_CREDIT",
      "citation": "17 CFR 240.15c3-3a, Item 3",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "3. Monies payable against customers' securities loaned"
    },
    {
      "id": "15c3-3a.item.04",
      "kind": "EXHIBIT_A_CREDIT",
      "citation": "17 CFR 240.15c3-3a, Item 4",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "4. Customers' securities failed to receive"
    },
    {
      "id": "15c3-3a.item.05",
      "kind": "EXHIBIT_A_CREDIT",
      "citation": "17 CFR 240.15c3-3a, Item 5",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "5. Credit balances in firm accounts which are attributable to principal sales to customers"
    },
    {
      "id": "15c3-3a.item.06",
      "kind": "EXHIBIT_A_CREDIT",
      "citation": "17 CFR 240.15c3-3a, Item 6",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "6. Market value of stock dividends, stock splits and similar distributions receivable outstanding over 30 calendar days"
    },
    {
      "id": "15c3-3a.item.07",
      "kind": "EXHIBIT_A_CREDIT",
      "citation": "17 CFR 240.15c3-3a, Item 7",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "7. Market value of short security count differences over 30 calendar days old"
    },
    {
      "id": "15c3-3a.item.08",
      "kind": "EXHIBIT_A_CREDIT",
      "citation": "17 CFR 240.15c3-3a, Item 8",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "8. Market value of short securities and credits (not to be offset by longs or by debits) in all suspense accounts over 30 calendar days"
    },
    {
      "id": "15c3-3a.item.09",
      "kind": "EXHIBIT_A_CREDIT",
      "citation": "17 CFR 240.15c3-3a, Item 9",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "9. Market value of securities which are in transfer in excess of 40 calendar days and have not been confirmed to be in transfer by the transfer agent or the issuer during the 40 days"
    },
    {
      "id": "15c3-3a.item.10",
      "kind": "EXHIBIT_A_DEBIT",
      "citation": "17 CFR 240.15c3-3a, Item 10",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "10. Debit balances in customers' cash and margin accounts excluding unsecured accounts and accounts doubtful of collection."
    },
    {
      "id": "15c3-3a.item.11",
      "kind": "EXHIBIT_A_DEBIT",
      "citation": "17 CFR 240.15c3-3a, Item 11",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "11. Securities borrowed to effectuate short sales by customers and securities borrowed to make delivery on customers' securities failed to deliver"
    },
    {
      "id": "15c3-3a.item.12",
      "kind": "EXHIBIT_A_DEBIT",
      "citation": "17 CFR 240.15c3-3a, Item 12",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "12. Failed to deliver of customers' securities not older than 30 calendar days"
    },
    {
      "id": "15c3-3a.item.13",
      "kind": "EXHIBIT_A_DEBIT",
      "citation": "17 CFR 240.15c3-3a, Item 13",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "13. Margin required and on deposit with the Options Clearing Corporation for all option contracts written or purchased in customer accounts."
    },
    {
      "id": "15c3-3a.item.14",
      "kind": "EXHIBIT_A_DEBIT",
      "citation": "17 CFR 240.15c3-3a, Item 14",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "14. Margin required and on deposit with a clearing agency registered with the Commission under section 17A of the Act (15 U.S.C. 78q-1) or a derivatives clearing organization registered with the Commodity Futures Trading Commission"
    },
    {
      "id": "15c3-3a.item.15",
      "kind": "EXHIBIT_A_DEBIT",
      "citation": "17 CFR 240.15c3-3a, Item 15",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "15. Margin required and on deposit with a clearing agency registered with the Commission under section 17A of the Act (15 U.S.C. 78q-1) resulting from the following types of transactions in U.S. Treasury securities in customer accounts"
    },
    {
      "id": "15c3-3a.note_e3.debit_reduction",
      "kind": "PERCENT",
      "citation": "17 CFR 240.15c3-3a, Note E(3)",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "Debit balances in customers' cash and margin accounts included in the formula under Item 10 must be reduced by an amount equal to 1 percent of their aggregate value",
      "figure": "1 percent",
      "value": "0.01"
    },
    {
      "id": "15c3-3a.pab_note_4.no_note_e3",
      "kind": "PROVISION",
      "citation": "17 CFR 240.15c3-3a, PAB Note 4",
      "source_id": "17cfr240.15c3-3a",
      "sha256": "8046b00e1ff4114afd773268cde5c2445fa714a1ed751def9499ee47d1682dbd",
      "quote": "Note E(3) to § 240.15c3-3a which reduces debit balances by 1 percent does not apply to the PAB reserve computation"
    },
    {
